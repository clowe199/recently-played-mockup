# All env vars are optional in the mockup — the demo runs entirely off
# the bundled sample data in src/lib/sampleHistory.ts. Wire these up
# when you swap the stub API routes for your real data source.

# CRON_SECRET=replace-me-with-a-random-string

# If you connect a database (Postgres on Railway/Vercel/Neon/etc.):
# DATABASE_URL=postgres://user:pass@host:5432/dbname
